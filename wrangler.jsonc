{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hallpass",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // The React app is served as static assets. Only /api/* reaches the Worker first.
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Keyed by the per-browser demo attendee ID, so testers don't block each other.
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],

  // Public workers.dev and preview URLs are off. Set both to true (or add a route
  // or custom domain) when you deploy your own copy, or the Worker has no URL.
  "workers_dev": false,
  "preview_urls": false,

  // Traces and logs stay in Workers Logs. To export them to an OTLP backend such as
  // Dash0, create destinations in your Cloudflare account and list them here, e.g.
  // "traces": { "enabled": true, "destinations": ["<your-traces-destination>"] }.
  "observability": {
    "enabled": true,
    "traces": { "enabled": true },
    "logs": { "enabled": true, "invocation_logs": true }
  },

  // Non-secret config. Secrets (ANTHROPIC_API_KEY, ELASTIC_API_KEY, ELASTIC_URL)
  // go in .dev.vars locally and `wrangler secret put` for the deployed Worker.
  "vars": {
    "ELASTIC_INDEX_PREFIX": "hallpass",
    "CLAUDE_MODEL": "claude-opus-5-5",
    // Shared read-only agenda. Writable indexes use ELASTIC_INDEX_PREFIX.
    "SESSIONS_INDEX": "hallpass-sessions"
  },

  // `wrangler preview` needs bindings and vars listed again. Previews don't inherit secrets.
  "previews": {
    "vars": {
      "ELASTIC_INDEX_PREFIX": "hallpass-preview",
      "CLAUDE_MODEL": "claude-opus-5-5",
      "SESSIONS_INDEX": "hallpass-sessions"
    },
    "ratelimits": [
      {
        "name": "API_LIMITER",
        "namespace_id": "1002",
        "simple": { "limit": 60, "period": 60 }
      }
    ]
  }
}
