{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hallpass",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // The React app is served as static assets. Only /api/* reaches the Worker first.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Keyed by the per-browser demo attendee ID, so judges don't block each other.
  // Raise before judging.
  "ratelimits": [
    {
      "name": "API_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],

  "observability": { "enabled": true },

  // Non-secret config. Secrets (ANTHROPIC_API_KEY, ELASTIC_API_KEY, ELASTIC_URL)
  // go in .dev.vars locally and `wrangler secret put` for the deployed Worker.
  "vars": {
    "ELASTIC_INDEX_PREFIX": "hallpass",
    "CLAUDE_MODEL": "claude-opus-5-5"
  }
}
